      "description": "One pronunciation observation, and what it is based on.\n\n`confirmed` requires audio. A correct transcript proves nothing about how something\nsounded, so a transcript-based observation is recorded as `observed` or `uncertain`\nand never becomes a confirmed pronunciation claim at close.",
      "properties": {
        "audio_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Artifact Id"
        },
        "dimension": {
          "default": "pronunciation",
          "title": "Dimension",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "package_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Id"
        },
        "response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "response_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Hash"
        },
        "response_visibility": {
          "anyOf": [
            {
              "enum": [
                "withheld",
                "excerpt",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Visibility"
        },
        "source": {
          "anyOf": [
            {
              "const": "package",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "status": {
          "enum": [
            "observed",
            "uncertain",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "transcript_layer": {
          "anyOf": [
            {
              "enum": [
                "raw",
                "normalized",
                "reviewed-hearing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Layer"
        },
        "utterance_id": {
          "anyOf": [
            {
              "pattern": "^utt_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utterance Id"
        }
      },
      "required": [
        "status",
        "note"
      ],
      "title": "StagedPronunciationPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One flush: an ordered, bounded set of observations from one block.\n\nThe sequence number and the idempotency key are what make a retry safe. A batch that\narrives twice with the same key and the same content is accepted once; the same key\nwith different content is a conflict rather than an overwrite, because the second\ncall would otherwise silently discard the first call's observations.",
  "properties": {
    "block": {
      "anyOf": [
        {
          "pattern": "^blk_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Block"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "attempt.observed": "#/$defs/StagedAttemptEvent",
            "correction.given": "#/$defs/StagedCorrectionEvent",
            "follow_up": "#/$defs/StagedFollowUpEvent",
            "observation.noted": "#/$defs/StagedObservationEvent",
            "pronunciation.assessment": "#/$defs/StagedPronunciationEvent"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StagedAttemptEvent"
          },
          {
            "$ref": "#/$defs/StagedCorrectionEvent"
          },
          {
            "$ref": "#/$defs/StagedPronunciationEvent"
          },
          {
            "$ref": "#/$defs/StagedObservationEvent"
          },
          {
            "$ref": "#/$defs/StagedFollowUpEvent"
          }
        ]
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "schema_name": {
      "const": "lingua.session.events.v1",
      "default": "lingua.session.events.v1",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "pattern": "^ses_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    }
  },
  "required": [
    "sequence",
    "idempotency_key",
    "events"
  ],
  "title": "SessionEventBatch",
  "type": "object",
  "x-linguawiki-semantic-model": "lingua.session.events.v1"
}
