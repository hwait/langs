          "default": "none",
          "enum": [
            "none",
            "prompted",
            "hinted",
            "scaffolded",
            "full-answer"
          ],
          "title": "Help Level",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "modality": {
          "enum": [
            "text",
            "audio",
            "speech",
            "writing"
          ],
          "title": "Modality",
          "type": "string"
        },
        "package_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Id"
        },
        "response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "response_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Hash"
        },
        "response_visibility": {
          "anyOf": [
            {
              "enum": [
                "withheld",
                "excerpt",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Visibility"
        },
        "retrieval": {
          "default": "immediate",
          "enum": [
            "immediate",
            "same-session",
            "delayed"
          ],
          "title": "Retrieval",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "source": {
          "anyOf": [
            {
              "const": "package",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "task_type": {
          "enum": [
            "objective",
            "short-response",
            "extended-productive",
            "pronunciation-target",
            "connected-speech",
            "meaning-focused-exchange",
            "reading-comprehension",
            "listening-comprehension",
            "recall-prompt"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "transcript_layer": {
          "anyOf": [
            {
              "enum": [
                "raw",
                "normalized",
                "reviewed-hearing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Layer"
        },
        "utterance_id": {
          "anyOf": [
            {
              "pattern": "^utt_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utterance Id"
        }
      },
      "required": [
        "task_type",
        "modality",
        "score"
      ],
      "title": "StagedAttemptPayload",
      "type": "object"
