    "StagedAttemptEvent": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "anyOf": [
            {
              "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity"
        },
        "block": {
          "anyOf": [
            {
              "pattern": "^blk_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        },
        "event_id": {
          "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "const": "attempt.observed",
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/StagedAttemptPayload"
        }
      },
      "required": [
        "event_id",
        "occurred_at",
        "kind",
        "payload"
      ],
      "title": "StagedAttemptEvent",
      "type": "object"
    },
    "StagedAttemptPayload": {
      "additionalProperties": false,
      "description": "One observed attempt: what was asked, what help was given, how it went.",
      "properties": {
        "assessor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessor"
        },
        "assessor_kind": {
          "default": "ai",
          "enum": [
            "deterministic",
            "ai",
            "learner",
            "human"
          ],
          "title": "Assessor Kind",
          "type": "string"
        },
        "claims": {
          "default": [],
          "items": {
            "enum": [
              "recognition",
              "comprehension",
              "controlled-production",
              "spontaneous-production",
              "delayed-transfer",
              "intelligibility"
            ],
            "type": "string"
          },
          "title": "Claims",
          "type": "array"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "correction_mode": {
          "default": "none",
          "enum": [
            "none",
            "delayed",
            "immediate",
            "recast",
            "explicit"
          ],
          "title": "Correction Mode",
          "type": "string"
        },
        "delay_hours": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
